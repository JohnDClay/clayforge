# ClayForge .dockerignore — keeps images small and secrets out
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE / editor / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Environment & secrets — never ship these
.env
.env.*
*.pem
secrets/
*.key

# Test / dev / cache artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
*.cover
.tox/

# Optional frontend junk (if you ever add any)
node_modules/

# Documentation & repo files (keep image tiny)
*.md
!README.md
LICENSE
CHANGELOG.md
CONTRIBUTING.md
STATUS.md
