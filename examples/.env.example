# ClayForge example environment file.
# Copy to .env and fill in your own values (never commit real secrets).
# This is safe to commit.

# =============================================================================
# For real Grok / xAI streaming in GrokChat, AgentCanvas, examples, gallery tester:
# Get a key at https://console.x.ai
# Then either:
#   - export XAI_API_KEY=your_key_here   (before running)
#   - or pass explicitly: GrokChat(api_key="xai-...")
#
# The framework ALWAYS works without a key (beautiful high-fidelity simulation).
# Real streaming is 100% opt-in and explicit.
# =============================================================================
XAI_API_KEY=your_xai_key_here

# Optional: model selection
# XAI_MODEL=grok-4.3

# For auth (optional stronger signing in production)
# CLAYFORGE_AUTH_SECRET=change-me-to-a-long-random-string-in-prod

# For DB (optional)
# CLAYFORGE_DB_URL=sqlite:///./myapp.db
# or postgresql+asyncpg://...

# Development
LOG_LEVEL=INFO
